{
  "name": "agriforce-machines",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "install:ci": "npm ci",
    "install:sites": "bash scripts/install-ci.sh",
    "dev": "vite",
    "dev:backend": "npm --prefix backend run dev",
    "build:backend": "npm --prefix backend run build",
    "build": "next build",
    "build:sites": "bash scripts/build-verified.sh",
    "vercel-build": "next build",
    "start": "next start",
    "start:sites": "vinext start",
    "test": "npm run lint && npm run build",
    "test:rendered": "node --test tests/rendered-html.test.mjs",
    "test:e2e": "node tests/e2e-commerce.mjs",
    "validate:artifact": "bash scripts/validate-artifact.sh",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "i18next": "^26.3.6",
    "next": "16.2.6",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "react-i18next": "^17.0.11"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "puppeteer-core": "^25.5.0",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module",
  "displayName": "AgriForce Machines"
}
